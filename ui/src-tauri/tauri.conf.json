{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Whspr",
  "version": "0.1.0",
  "identifier": "com.whspr.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Whspr Settings",
        "label": "main",
        "width": 1000,
        "height": 700,
        "resizable": true,
        "fullscreen": false,
        "visible": true
      },
      {
        "title": "",
        "label": "widget",
        "url": "/widget",
        "width": 380,
        "height": 60,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "x": 500,
        "y": 900
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
